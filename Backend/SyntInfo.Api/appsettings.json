{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\logs\\SynthInfo\\log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=syntinfo_db;Username=synt_user;Password=synt_password"
  },
  "Llm": {
    "BaseUrl": "http://localhost:12434/",
    "ModelName": "ai/llama3.2:latest",
    "UseMock": false
  },
  "ProcessingSettings": {
    "MaxArticlesPerRegion": 5
  },
  "Search": {
    "TavilyApiKey": "PLACEHOLDER_TAVILY_KEY"
  },
  "OpenRouter": {
    "ApiKey": "PLACEHOLDER_OPENROUTER_KEY",
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "AnalystModel": "google/gemma-4-31b-it:free",
    "EditorModel": "qwen/qwen3-next-80b-a3b-instruct:free",
    "FallbackModel": "openrouter/free"
  },
  "GoogleAiStudio": {
    "ApiKey": "PLACEHOLDER_GOOGLE_KEY",
    "Model": "gemini-3.1-flash-lite"
  },
