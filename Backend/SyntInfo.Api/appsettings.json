{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\logs\\SynthInfo\\log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=syntinfo_db;Username=synt_user;Password=synt_password"
  },
  "Llm": {
    "BaseUrl": "http://localhost:12434/",
    "ModelName": "ai/llama3.2:latest",
    "UseMock": false
  },
  "ProcessingSettings": {
    "MaxArticlesPerRegion": 5
  },
  "Search": {
    "TavilyApiKey": "PLACEHOLDER_TAVILY_KEY"
  },
  "OpenRouter": {
    "ApiKey": "PLACEHOLDER_OPENROUTER_KEY",
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "AnalystModel": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
    "EditorModel": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
    "FallbackModel": "google/gemini-2.0-flash-lite-preview-02-05:free"
  },
  "GoogleAiStudio": {
    "ApiKey": "PLACEHOLDER_GOOGLE_KEY",
    "Model": "gemini-3.1-flash-lite"
  },
  "RssSources": {
    "Poland": [
      { "Name": "TVN24 Najnowsze", "Url": "https://tvn24.pl/najnowsze.xml" },
      { "Name": "Onet Wiadomości", "Url": "https://wiadomosci.onet.pl/.feed" },
      { "Name": "WP Wiadomości", "Url": "https://wiadomosci.wp.pl/rss.xml" },
      { "Name": "RMF24 Fakty", "Url": "https://www.rmf24.pl/fakty/feed" },
      { "Name": "Polsat News", "Url": "https://www.polsatnews.pl/rss/wszystkie.xml" },
      { "Name": "Bankier.pl", "Url": "https://www.bankier.pl/rss/wiadomosci.xml" },
      { "Name": "Money.pl", "Url": "https://www.money.pl/rss/main.xml" },
      { "Name": "Niebezpiecznik", "Url": "https://niebezpiecznik.pl/feed/" },
      { "Name": "Zaufana Trzecia Strona", "Url": "https://zaufanatrzeciastrona.pl/feed/" },
      { "Name": "Antyweb", "Url": "https://antyweb.pl/feed" },
      { "Name": "Google News PL", "Url": "https://news.google.com/rss/search?q=when:24h&hl=pl&gl=PL&ceid=PL:pl" }
    ],
    "World": [
      { "Name": "BBC News World", "Url": "http://feeds.bbci.co.uk/news/world/rss.xml" },
      { "Name": "Reuters via Google News", "Url": "https://news.google.com/rss/search?q=source:Reuters+when:24h&hl=en-US&gl=US&ceid=US:en" },
      { "Name": "Al Jazeera", "Url": "https://www.aljazeera.com/xml/rss/all.xml" },
      { "Name": "CNN Top Stories", "Url": "http://rss.cnn.com/rss/cnn_topstories.rss" },
      { "Name": "The Guardian World", "Url": "https://www.theguardian.com/world/rss" },
      { "Name": "Bloomberg Technology", "Url": "https://feeds.bloomberg.com/technology/news.rss" },
      { "Name": "TechCrunch", "Url": "https://techcrunch.com/feed/" },
      { "Name": "The Verge", "Url": "https://www.theverge.com/rss/index.xml" },
      { "Name": "Ars Technica", "Url": "http://feeds.arstechnica.com/arstechnica/index" },
      { "Name": "Wired Top Stories", "Url": "https://www.wired.com/feed/rss" },
      { "Name": "Google News World", "Url": "https://news.google.com/rss/search?q=when:24h&hl=en-US&gl=US&ceid=US:en" }
    ]
  }
}
