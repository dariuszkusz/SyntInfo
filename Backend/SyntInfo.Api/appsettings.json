{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\logs\\SynthInfo\\log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "FrontendUrl": "http://localhost:4200",
  "Admin": {
    "ApiKey": "PLACEHOLDER_ADMIN_API_KEY"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=syntinfo_db;Username=synt_user;Password=synt_password"
  },
  "Llm": {
    "BaseUrl": "http://localhost:12434/",
    "ModelName": "ai/llama3.2:latest",
    "UseMock": false
  },
  "ProcessingSettings": {
    "MaxArticlesPerRegion": 10,
    "MaxPositiveArticles": 10
  },
  "Search": {
    "TavilyApiKey": "PLACEHOLDER_TAVILY_KEY"
  },
  "OpenRouter": {
    "ApiKey": "PLACEHOLDER_OPENROUTER_KEY",
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "AnalystModel": "openai/gpt-6-luna",
    "EditorModel": "deepseek/deepseek-v4.1-flash",
    "FallbackModel": "deepseek/deepseek-chat"
  },
  "GoogleAiStudio": {
    "ApiKey": "PLACEHOLDER_GOOGLE_KEY",
    "Model": "gemini-3.5-flash",
    "FallbackModel": "gemini-3.1-flash-lite"
  },
  "Telegram": {
    "BotToken": "PLACEHOLDER_TELEGRAM_BOT_TOKEN",
    "AdminChatId": "PLACEHOLDER_ADMIN_CHAT_ID",
    "SecretToken": "PLACEHOLDER_TELEGRAM_SECRET_TOKEN",
    "UseMock": false
  },
  "SocialPlatforms": {
    "MaxArticlesPerRun": 5,
    "MaxPolandArticles": 5,
    "MaxWorldArticles": 5,
    "MaxPositiveArticles": 5,
    "ProposalPolandCount": 10,
    "ProposalWorldCount": 10,
    "ProposalPositiveCount": 10,
    "Wykop": {
      "BaseUrl": "https://wykop.pl/api/v3/",
      "Token": "PLACEHOLDER_WYKOP_TOKEN",
      "UseMock": false
    },
    "Hejto": {
      "BaseUrl": "https://api.hejto.pl/",
      "AuthUrl": "https://auth.hejto.pl/token",
      "ClientId": "PLACEHOLDER_HEJTO_CLIENT_ID",
      "ClientSecret": "PLACEHOLDER_HEJTO_CLIENT_SECRET",
      "DefaultCommunity": "wiadomosci-polska",
      "PublishArticlesSeparately": true,
      "DelayBetweenPostsSeconds": 60,
      "DelayBetweenPostsMs": 1500,
      "UseMock": false
    },
    "Facebook": {
      "BaseUrl": "https://graph.facebook.com/v19.0/",
      "PageId": "PLACEHOLDER_PAGE_ID",
      "PageAccessToken": "PLACEHOLDER_FB_TOKEN",
      "UseMock": true
    },
    "MailerLite": {
      "BaseUrl": "https://connect.mailerlite.com/api/",
      "ApiKey": "PLACEHOLDER_MAILERLITE_KEY",
      "FromEmail": "kontakt@infoskrot.pl",
      "FromName": "InfoSkrót",
      "Enabled": true,
      "UseMock": false
    }
  },
  "RssSources": {
