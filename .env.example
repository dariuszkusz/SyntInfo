# ==============================================================================
# SyntInfo - Wzorcowy plik zmiennych środowiskowych (.env.example)
# Skopiuj ten plik jako .env i uzupełnij wartości przed uruchomieniem docker-compose.
# ==============================================================================

# --- Baza Danych PostgreSQL ---
POSTGRES_USER=synt_user
POSTGRES_PASSWORD=twoje_bezpieczne_haslo_do_bazy
POSTGRES_DB=syntinfo_db

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@infoskrot.pl
PGADMIN_DEFAULT_PASSWORD=twoje_bezpieczne_haslo_pgadmin

# --- Frontend & Domeny ---
FRONTEND_URL=https://infoskrot.pl

# --- Klucz administracyjny API ---
ADMIN_API_KEY=twoj_bezpieczny_klucz_admin_api

# --- Integracje LLM & Search ---
OPENROUTER_API_KEY=twoj_klucz_openrouter
TAVILY_API_KEY=twoj_klucz_tavily
GOOGLE_AI_KEY=twoj_klucz_google_ai_studio

# --- Telegram Bot & Curation ---
TELEGRAM_BOT_TOKEN=twoj_token_bota_telegram
TELEGRAM_ADMIN_CHAT_ID=twoj_chat_id_telegram
TELEGRAM_SECRET_TOKEN=twoj_tajny_token_webhooka_telegram

# --- Platformy Społecznościowe ---
WYKOP_KEY=twoj_wykop_app_key
WYKOP_SECRET=twoj_wykop_secret
WYKOP_TOKEN=twoj_wykop_user_token
HEJTO_CLIENT_ID=twoj_hejto_client_id
HEJTO_CLIENT_SECRET=twoj_hejto_client_secret

# --- Logi ---
SERILOG_PATH=/app/logs/log-.txt
